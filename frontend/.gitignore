# ==========================================

# RASSAM — Git Ignore Rules

# ==========================================

# 1. Environment variables and secrets

.env
.env.*
!.env.example
!.env.sample


# 3. Dependencies

node_modules/

# 4. Vercel local configuration

.vercel/

# 5. Build output

dist/
build/
out/

# 6. Logs and debugging files

*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# 7. Private keys and certificates

*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# 8. Local databases and backups

*.sqlite
*.sqlite3
*.db
*.dump
*.bak
*.backup
*.tmp

# 9. Operating system files

.DS_Store
Thumbs.db
Desktop.ini

# 10. Editor settings

.vscode/
.idea/
*.swp
*.swo

# 11. Coverage and test output

coverage/

# 12. Local-only configuration

*.local

frontend/.env
.vercel
.env*
